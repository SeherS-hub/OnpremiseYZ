<?xml version="1.0" encoding="utf-8"?>
<!--
  POC · Satış Dashboard'u
  Hedef: Power BI Report Server (PBIRS) veya SQL Server Reporting Services 2019+
  Kaynak: SSAS Tabular · POC_Satis (tek analitik kaynak, DAX)
  Özellik: Her satırda "Asistana sor" action'ı, ajanı soru hazır şekilde açar.

  NOT: Bu makinede rapor sunucusu kurulu olmadığı için rapor RENDER EDİLEREK
  DOĞRULANMAMIŞTIR. Kurulumdan sonra Report Builder ile açıp bir kez
  önizlemek gerekir; şema 2016 RDL'dir ve PBIRS/SSRS 2019+ ile uyumludur.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Satış özeti ve detay kırılımları · yönetici asistanı entegrasyonlu</Description>
  <Author>Veri &amp; Yapay Zekâ Platformu</Author>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="dsSSAS">
      <ConnectionProperties>
        <DataProvider>OLEDB-MD</DataProvider>
        <ConnectString>Data Source=localhost\TABULAR;Initial Catalog=POC_Satis</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
    </DataSource>
  </DataSources>

  <DataSets>
    <!-- Dönem parametresinin değer listesi -->
    <DataSet Name="Donemler">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>EVALUATE
SELECTCOLUMNS ( Donem, "DonemAd", Donem[Dönem], "DonemKey", Donem[DonemKey] )
ORDER BY [DonemKey]</CommandText>
      </Query>
      <Fields>
        <Field Name="DonemAd"><DataField>[DonemAd]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DonemKey"><DataField>[DonemKey]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Üst KPI şeridi -->
    <DataSet Name="KPI">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>="EVALUATE" &amp; vbCrLf &amp;
"VAR __f = FILTER ( ALL ( Donem[Dönem] ), Donem[Dönem] IN { """ &amp;
Join(Parameters!pDonem.Value, """, """) &amp; """ } )" &amp; vbCrLf &amp;
"RETURN ROW (" &amp; vbCrLf &amp;
"  ""NetCiro"", CALCULATE ( [Net Ciro], __f )," &amp; vbCrLf &amp;
"  ""Hedef"", CALCULATE ( [Hedef], __f )," &amp; vbCrLf &amp;
"  ""SatisAdet"", CALCULATE ( [Satış Adet], __f )," &amp; vbCrLf &amp;
"  ""MusteriSayisi"", CALCULATE ( [Müşteri Sayısı], __f )" &amp; vbCrLf &amp; ")"</CommandText>
      </Query>
      <Fields>
        <Field Name="NetCiro"><DataField>[NetCiro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Hedef"><DataField>[Hedef]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="SatisAdet"><DataField>[SatisAdet]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="MusteriSayisi"><DataField>[MusteriSayisi]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Aylık trend -->
    <DataSet Name="Trend">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>="EVALUATE" &amp; vbCrLf &amp;
"SUMMARIZECOLUMNS (" &amp; vbCrLf &amp;
"  Donem[DonemKey], Donem[Dönem]," &amp; vbCrLf &amp;
"  FILTER ( ALL ( Donem[Dönem] ), Donem[Dönem] IN { """ &amp;
Join(Parameters!pDonem.Value, """, """) &amp; """ } )," &amp; vbCrLf &amp;
"  ""NetCiro"", [Net Ciro]," &amp; vbCrLf &amp;
"  ""Hedef"", [Hedef]," &amp; vbCrLf &amp;
"  ""SatisAdet"", [Satış Adet]," &amp; vbCrLf &amp;
"  ""OncekiAyCiro"", [Önceki Ay Ciro]," &amp; vbCrLf &amp;
"  ""AylikDegisim"", [Aylık Değişim %]," &amp; vbCrLf &amp;
"  ""HedefGerceklesme"", [Hedef Gerçekleşme %]" &amp; vbCrLf &amp;
")" &amp; vbCrLf &amp; "ORDER BY Donem[DonemKey]"</CommandText>
      </Query>
      <Fields>
        <Field Name="DonemKey"><DataField>Donem[DonemKey]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="DonemAd"><DataField>Donem[Dönem]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="NetCiro"><DataField>[NetCiro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Hedef"><DataField>[Hedef]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="SatisAdet"><DataField>[SatisAdet]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="OncekiAyCiro"><DataField>[OncekiAyCiro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="AylikDegisim"><DataField>[AylikDegisim]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="HedefGerceklesme"><DataField>[HedefGerceklesme]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Gerçekleşen + tahmin, TEK eksende.
         Kaynak modeldeki CiroSerisi tablosu; tahmin satırlarını oraya
         ajan yazıyor (04-ajan-py/araclar/tahmin_yayinla.py). Tahmini
         DAX'ta yeniden hesaplamıyoruz: aynı soruya ajan ve dashboard
         farklı sayı veremez.

         Dönem süzgeci yalnız GERÇEKLEŞEN satırlara uygulanıyor. Tahmin
         dönemleri (2026-09…) pDonem listesinde yok — süzgece soksaydık
         tahmin hiçbir seçimde görünmezdi. Tahmin bir boyut değil,
         grafiğin üzerine düşen bir katman. -->
    <DataSet Name="TrendSeri">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>="EVALUATE" &amp; vbCrLf &amp;
"SUMMARIZECOLUMNS (" &amp; vbCrLf &amp;
"  CiroSerisi[DonemKey], CiroSerisi[Dönem]," &amp; vbCrLf &amp;
"  FILTER ( ALL ( CiroSerisi )," &amp; vbCrLf &amp;
"    CiroSerisi[Tip] = ""Tahmin"" || CiroSerisi[Dönem] IN { """ &amp;
Join(Parameters!pDonem.Value, """, """) &amp; """ } )," &amp; vbCrLf &amp;
"  ""Ciro"", [Gerçekleşen Ciro]," &amp; vbCrLf &amp;
"  ""Hedef"", [Aylık Hedef]," &amp; vbCrLf &amp;
"  ""Tahmin"", [Tahmin]," &amp; vbCrLf &amp;
"  ""TahminAlt"", [Tahmin %80 Alt]," &amp; vbCrLf &amp;
"  ""TahminUst"", [Tahmin %80 Üst]" &amp; vbCrLf &amp;
")" &amp; vbCrLf &amp; "ORDER BY CiroSerisi[DonemKey]"</CommandText>
      </Query>
      <Fields>
        <Field Name="DonemKey"><DataField>CiroSerisi[DonemKey]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="DonemAd"><DataField>CiroSerisi[Dönem]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Ciro"><DataField>[Ciro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Hedef"><DataField>[Hedef]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Tahmin"><DataField>[Tahmin]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TahminAlt"><DataField>[TahminAlt]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TahminUst"><DataField>[TahminUst]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Bölge kırılımı -->
    <DataSet Name="Bolge">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>="EVALUATE" &amp; vbCrLf &amp;
"SUMMARIZECOLUMNS (" &amp; vbCrLf &amp;
"  Bolge[Bölge]," &amp; vbCrLf &amp;
"  FILTER ( ALL ( Donem[Dönem] ), Donem[Dönem] IN { """ &amp;
Join(Parameters!pDonem.Value, """, """) &amp; """ } )," &amp; vbCrLf &amp;
"  ""NetCiro"", [Net Ciro]," &amp; vbCrLf &amp;
"  ""Hedef"", [Hedef]," &amp; vbCrLf &amp;
"  ""SatisAdet"", [Satış Adet]," &amp; vbCrLf &amp;
"  ""HedefGerceklesme"", [Hedef Gerçekleşme %]" &amp; vbCrLf &amp;
")" &amp; vbCrLf &amp; "ORDER BY [NetCiro] DESC"</CommandText>
      </Query>
      <Fields>
        <Field Name="BolgeAd"><DataField>Bolge[Bölge]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="NetCiro"><DataField>[NetCiro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Hedef"><DataField>[Hedef]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="SatisAdet"><DataField>[SatisAdet]</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="HedefGerceklesme"><DataField>[HedefGerceklesme]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Ürün grubu × kanal matrisi -->
    <DataSet Name="UrunKanal">
      <Query>
        <DataSourceName>dsSSAS</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>="EVALUATE" &amp; vbCrLf &amp;
"SUMMARIZECOLUMNS (" &amp; vbCrLf &amp;
"  UrunGrubu[Ürün Grubu], Kanal[Kanal]," &amp; vbCrLf &amp;
"  FILTER ( ALL ( Donem[Dönem] ), Donem[Dönem] IN { """ &amp;
Join(Parameters!pDonem.Value, """, """) &amp; """ } )," &amp; vbCrLf &amp;
"  ""NetCiro"", [Net Ciro]" &amp; vbCrLf &amp; ")"</CommandText>
      </Query>
      <Fields>
        <Field Name="UrunGrubuAd"><DataField>UrunGrubu[Ürün Grubu]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="KanalAd"><DataField>Kanal[Kanal]</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="NetCiro"><DataField>[NetCiro]</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="pDonem">
      <DataType>String</DataType>
      <Prompt>Dönem</Prompt>
      <MultiValue>true</MultiValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Donemler</DataSetName>
          <ValueField>DonemAd</ValueField>
          <LabelField>DonemAd</LabelField>
        </DataSetReference>
      </ValidValues>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>Donemler</DataSetName>
          <ValueField>DonemAd</ValueField>
        </DataSetReference>
      </DefaultValue>
    </ReportParameter>
    <ReportParameter Name="pAjanUrl">
      <DataType>String</DataType>
      <Prompt>Asistan adresi</Prompt>
      <DefaultValue>
        <Values>
          <Value>http://localhost:8787</Value>
        </Values>
      </DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- ================= BAŞLIK ================= -->
          <Textbox Name="txtBaslik">
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.34in</Height>
            <Width>7.4in</Width>
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Satış Dashboard'u</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>17pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#141A20</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
            </Style>
          </Textbox>
          <Textbox Name="txtAltBaslik">
            <Top>0.36in</Top>
            <Left>0in</Left>
            <Height>0.26in</Height>
            <Width>7.4in</Width>
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Seçili dönem: " &amp; Join(Parameters!pDonem.Value, ", ") &amp;
                  "   ·   Kaynak: SSAS · POC_Satis   ·   Üretim: " &amp;
                  Format(Globals!ExecutionTime, "dd.MM.yyyy HH:mm")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#74838A</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
            </Style>
          </Textbox>
          <!-- ================= KPI ŞERİDİ ================= -->
          <Textbox Name="kpiCiro">
            <Top>0.72in</Top>
            <Left>0in</Left>
            <Height>0.72in</Height>
            <Width>1.75in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>NET CİRO</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#74838A</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!NetCiro.Value, "KPI") / 1000000, "#,0.0") &amp; " mn TL"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#141A20</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <Border>
                <Color>#D2DBDF</Color>
                <Style>Solid</Style>
                <Width>1pt</Width>
              </Border>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <PaddingLeft>8pt</PaddingLeft>
              <PaddingTop>6pt</PaddingTop>
            </Style>
          </Textbox>
          <Textbox Name="kpiHedef">
            <Top>0.72in</Top>
            <Left>1.9in</Left>
            <Height>0.72in</Height>
            <Width>1.75in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>HEDEF GERÇEKLEŞME</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#74838A</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!NetCiro.Value, "KPI") / First(Fields!Hedef.Value, "KPI"), "0.0%")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>=IIf(First(Fields!NetCiro.Value,"KPI") &gt;= First(Fields!Hedef.Value,"KPI"), "#2C6B4C", "#93262B")</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <Border>
                <Color>#D2DBDF</Color>
                <Style>Solid</Style>
                <Width>1pt</Width>
              </Border>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <PaddingLeft>8pt</PaddingLeft>
              <PaddingTop>6pt</PaddingTop>
            </Style>
          </Textbox>
          <Textbox Name="kpiAdet">
            <Top>0.72in</Top>
            <Left>3.8in</Left>
            <Height>0.72in</Height>
            <Width>1.75in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>SATIŞ ADEDİ</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#74838A</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!SatisAdet.Value, "KPI"), "#,0")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#141A20</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <Border>
                <Color>#D2DBDF</Color>
                <Style>Solid</Style>
                <Width>1pt</Width>
              </Border>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <PaddingLeft>8pt</PaddingLeft>
              <PaddingTop>6pt</PaddingTop>
            </Style>
          </Textbox>
          <Textbox Name="kpiSepet">
            <Top>0.72in</Top>
            <Left>5.65in</Left>
            <Height>0.72in</Height>
            <Width>1.75in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>ORTALAMA SEPET</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#74838A</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!NetCiro.Value,"KPI") / First(Fields!SatisAdet.Value,"KPI"), "#,0") &amp; " TL"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#141A20</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <Border>
                <Color>#D2DBDF</Color>
                <Style>Solid</Style>
                <Width>1pt</Width>
              </Border>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <PaddingLeft>8pt</PaddingLeft>
              <PaddingTop>6pt</PaddingTop>
            </Style>
          </Textbox>
          <!-- ================= AJANA GİT DÜĞMESİ ================= -->
          <Textbox Name="btnAsistan">
            <Top>1.56in</Top>
            <Left>0in</Left>
            <Height>0.3in</Height>
            <Width>7.4in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Yönetici Asistanına sor  —  sesli veya yazılı  →</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#FFFFFF</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <ActionInfo>
              <Actions>
                <Action>
                  <Hyperlink>=Parameters!pAjanUrl.Value &amp; "/?soru=" &amp;
            System.Uri.EscapeDataString(
              IIf(Parameters!pDonem.Count = 1,
                  Parameters!pDonem.Value(0) &amp; " döneminde hedefi tuttuk mu?",
                  "Son 10 ayın ortalama aylık cirosu ne?"))</Hyperlink>
                </Action>
              </Actions>
            </ActionInfo>
            <Style>
              <BackgroundColor>#1B5C77</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
            </Style>
          </Textbox>
          <!-- ================= AYLIK TREND GRAFİĞİ ================= -->
          <Chart Name="chartTrend">
            <Top>1.98in</Top>
            <Left>0in</Left>
            <Height>2.3in</Height>
            <Width>7.4in</Width>
            <DataSetName>TrendSeri</DataSetName>
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="grpDonem">
                    <GroupExpressions>
                      <GroupExpression>=Fields!DonemAd.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!DonemKey.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <Label>=Fields!DonemAd.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Label>Net Ciro</Label>
                </ChartMember>
                <ChartMember>
                  <Label>Hedef</Label>
                </ChartMember>
                <ChartMember>
                  <Label>Tahmin</Label>
                </ChartMember>
                <ChartMember>
                  <Label>%80 üst</Label>
                </ChartMember>
                <ChartMember>
                  <Label>%80 alt</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="serCiro">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!Ciro.Value)/1000000</Y>
                      </ChartDataPointValues>
                      <Style>
                        <BackgroundColor>#1B5C77</BackgroundColor>
                      </Style>
                      <ActionInfo>
                        <Actions>
                          <Action>
                            <Hyperlink>=Parameters!pAjanUrl.Value &amp; "/?soru=" &amp;
                    System.Uri.EscapeDataString(Fields!DonemAd.Value &amp; " döneminde net ciro ne kadar?")</Hyperlink>
                          </Action>
                        </Actions>
                      </ActionInfo>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Column</Type>
                  <Subtype>Plain</Subtype>
                  <ValueAxisName>Birincil</ValueAxisName>
                  <CategoryAxisName>Kategori</CategoryAxisName>
                  <ChartAreaName>Alan</ChartAreaName>
                </ChartSeries>
                <ChartSeries Name="serHedef">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=IIf(IsNothing(Sum(Fields!Hedef.Value)), Nothing, Sum(Fields!Hedef.Value)/1000000)</Y>
                      </ChartDataPointValues>
                      <Style>
                        <BackgroundColor>#A9541E</BackgroundColor>
                      </Style>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Line</Type>
                  <Subtype>Plain</Subtype>
                  <ValueAxisName>Birincil</ValueAxisName>
                  <CategoryAxisName>Kategori</CategoryAxisName>
                  <ChartAreaName>Alan</ChartAreaName>
                </ChartSeries>
                <!-- TAHMİN · içi açık, kesikli kenarlıklı sütun. Renk ailesi
                     gerçekleşenle aynı (mavi) ama açık ve kesikli: "aynı ölçü,
                     henüz gerçekleşmedi". Sütun tıklanınca ajana tahmin
                     sorusuyla gidiyor — sayının nasıl çıktığı orada yazıyor. -->
                <ChartSeries Name="serTahmin">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=IIf(IsNothing(Sum(Fields!Tahmin.Value)), Nothing, Sum(Fields!Tahmin.Value)/1000000)</Y>
                      </ChartDataPointValues>
                      <Style>
                        <BackgroundColor>#DCE7EE</BackgroundColor>
                        <Border>
                          <Color>#1B5C77</Color>
                          <Style>Dashed</Style>
                          <Width>1pt</Width>
                        </Border>
                      </Style>
                      <ActionInfo>
                        <Actions>
                          <Action>
                            <Hyperlink>=Parameters!pAjanUrl.Value &amp; "/?soru=" &amp;
                    System.Uri.EscapeDataString("Önümüzdeki 3 ayın ciro tahmini ne?")</Hyperlink>
                          </Action>
                        </Actions>
                      </ActionInfo>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Column</Type>
                  <Subtype>Plain</Subtype>
                  <ValueAxisName>Birincil</ValueAxisName>
                  <CategoryAxisName>Kategori</CategoryAxisName>
                  <ChartAreaName>Alan</ChartAreaName>
                </ChartSeries>
                <ChartSeries Name="serTahminUst">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=IIf(IsNothing(Sum(Fields!TahminUst.Value)), Nothing, Sum(Fields!TahminUst.Value)/1000000)</Y>
                      </ChartDataPointValues>
                      <Style>
                        <Border>
                          <Color>#5E8CA8</Color>
                          <Style>Dashed</Style>
                          <Width>1.5pt</Width>
                        </Border>
                      </Style>
                      <ChartMarker><Type>None</Type></ChartMarker>
